          const key = el.getAttribute("data-i18n");
          if (dict[key]) el.textContent = dict[key];
        });
        document.querySelectorAll(".sk-lang-btn").forEach((b) => {
          b.classList.toggle("active", b.getAttribute("data-lang") === lang);
        });
        try { localStorage.setItem("sk_lang", lang); } catch (e) {}
      }

      document.querySelectorAll(".sk-lang-btn").forEach((btn) => {
        btn.addEventListener("click", () => applyLang(btn.getAttribute("data-lang")));
      });

      function setupDropdown(ddId, btnId) {
        const dd = document.getElementById(ddId);
        const btn = document.getElementById(btnId);
        if (!dd || !btn) return;
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          document.querySelectorAll(".sk-dropdown").forEach((other) => {
            if (other !== dd) other.classList.remove("open");
          });
          const isOpen = dd.classList.toggle("open");
          btn.setAttribute("aria-expanded", String(isOpen));
        });
      }

