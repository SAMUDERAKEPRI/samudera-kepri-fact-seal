          dd.classList.remove("open");
          const b = dd.querySelector(".sk-dd-trigger");
          if (b) b.setAttribute("aria-expanded", "false");
        });
      });

      let savedLang = "id";
      try { savedLang = localStorage.getItem("sk_lang") || "id"; } catch (e) {}
      applyLang(savedLang);
