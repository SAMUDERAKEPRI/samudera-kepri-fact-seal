  <script src="./sk-bokeh-motion.js" defer></script>
  <script src="./sk-footer.js" defer></script>
  <script>
    (function () {
      const POSTS = [
        {
          id: "sk-01",
          cat: "transparansi",
          catLabel: "TRANSPARANSI PUBLIK",
          status: "ON-CHAIN SEALED",
          title: "Penyegelan Arsip & Keterbukaan Informasi Publik di Kepulauan Riau",
          excerpt: "Catatan dokumentasi publikasi samuderakepri.co.id yang dicatat sidik jari integritasnya agar mudah dirujuk kembali.",
          hash: "0x8f4c2b9e7a10d3c65491e2b8a7d0f3c91248b6e5d7a1c3f8b2e4d6a9c1f3e5b7",
          url: "https://www.samuderakepri.co.id/"
        },
        {
          id: "sk-02",
          cat: "investigasi",
          catLabel: "GELAR FAKTA & INVESTIGASI",
          status: "VERIFIED ARCHIVE",
          title: "Jejak Dokumentasi & Verifikasi Fakta Lapangan Samudera Kepri",
          excerpt: "Rujukan liputan investigatif dan gelar fakta yang disiapkan untuk pemeriksaan keaslian dokumen dan arsip.",
          hash: "0x3c9e71a4d82b5f0691c3e7a2b5d8f1046c9e2a4f7b1d3e6a8c0f2b4d6e8a1c3f",
          url: "https://www.samuderakepri.co.id/"
        },
        {
          id: "sk-03",
          cat: "ekosistem",
          catLabel: "COIN MSK & EKOSISTEM",
          status: "SEPOLIA PREP",
          title: "Kesiapan Ekosistem Coin MSK, FactSeal & Arsip NFT Menuju Ethereum",
          excerpt: "Ringkasan perkembangan modul ekosistem Samudera Kepri pada jaringan uji Sepolia sebelum migrasi lanjutan.",
          hash: "0x6d1a4f8c2e5b9073a1d4f7c0e3b6a9d2f5c8e1b4d7a0c3f6e9b2d5a8c1f4e7b0",
          url: "https://www.samuderakepri.co.id/"
        }
      ];

      let activeCat = "all";
      let searchQuery = "";

      function renderPosts() {
        const container = document.getElementById("sk-blog-list");
        if (!container) return;

        const q = searchQuery.trim().toLowerCase();
        const filtered = POSTS.filter((p) => {
          const matchCat = activeCat === "all" || p.cat === activeCat;
          const matchQ =
            !q ||
            p.title.toLowerCase().includes(q) ||
            p.excerpt.toLowerCase().includes(q) ||
            p.hash.toLowerCase().includes(q);
          return matchCat && matchQ;
        });

        if (!filtered.length) {
          container.innerHTML = '<div class="sk-empty">Tidak ada catatan berita yang cocok dengan filter atau kata kunci.</div>';
          return;
        }

        container.innerHTML = filtered
          .map(
            (p) =>
              '<article class="sk-post">' +
                '<div>' +
                  '<div class="sk-post-top">' +
                    '<span class="sk-cat">' + p.catLabel + '</span>' +
                    '<span class="sk-status">' + p.status + '</span>' +
                  '</div>' +
                  '<h2>' + p.title + '</h2>' +
                  '<p>' + p.excerpt + '</p>' +
                '</div>' +
                '<div class="sk-hash-box"><strong>contentHash:</strong> ' + p.hash + '</div>' +
                '<div class="sk-post-actions">' +
                  '<a href="./explorer.html?hash=' + encodeURIComponent(p.hash) + '">Cek di Explorer &rarr;</a>' +
                  '<a href="' + p.url + '" target="_blank" rel="noopener noreferrer">Baca di samuderakepri.co.id &nearr;</a>' +
                '</div>' +
              '</article>'
          )
          .join("");
      }

      const searchInput = document.getElementById("sk-blog-search");
      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = e.target.value || "";
          renderPosts();
        });
      }

      document.querySelectorAll(".sk-filter-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeCat = btn.getAttribute("data-cat") || "all";
          document.querySelectorAll(".sk-filter-btn").forEach((b) => {
            b.classList.toggle("active", b === btn);
          });
          renderPosts();
        });
      });

      renderPosts();

      const I18N = {
        id: {
          nav_home: "BERANDA",
          nav_news: "BERITA & FACTSEAL",
          nav_coin_nft: "COIN MSK & NFT",
          nav_community: "KOMUNITAS",
          cta_portal: "PORTAL PUBLIK",
          bl_kicker: "BLOG BERITA ON-CHAIN · SAMUDERAKEPRI.CO.ID",
          bl_title: "Arsip Berita Samudera Kepri di Sistem Blockchain",
          bl_desc: "Kumpulan publikasi dan catatan liputan dari samuderakepri.co.id yang terhubung ke sistem penyegelan integritas dan verifikasi blockchain Samudera Kepri."
        },
        en: {
          nav_home: "HOME",
          nav_news: "NEWS & FACTSEAL",
          nav_coin_nft: "MSK COIN & NFT",
          nav_community: "COMMUNITY",
          cta_portal: "PUBLIC PORTAL",
          bl_kicker: "ON-CHAIN NEWS BLOG · SAMUDERAKEPRI.CO.ID",
          bl_title: "Samudera Kepri News Archive on Blockchain",
          bl_desc: "Publications and reporting records from samuderakepri.co.id connected to Samudera Kepri's integrity sealing and blockchain verification system."
        }
      };

      function applyLang(lang) {
        const dict = I18N[lang] || I18N.id;
        document.documentElement.lang = lang;
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (dict[key]) el.textContent = dict[key];
        });
        document.querySelectorAll(".sk-lang-btn").forEach((b) => {
          b.classList.toggle("active", b.getAttribute("data-lang") === lang);
        });
        try { localStorage.setItem("sk_lang", lang); } catch (e) {}
      }

      document.querySelectorAll(".sk-lang-btn").forEach((btn) => {
        btn.addEventListener("click", () => applyLang(btn.getAttribute("data-lang")));
      });

      function setupDropdown(ddId, btnId) {
        const dd = document.getElementById(ddId);
        const btn = document.getElementById(btnId);
        if (!dd || !btn) return;
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          document.querySelectorAll(".sk-dropdown").forEach((other) => {
            if (other !== dd) other.classList.remove("open");
          });
          const isOpen = dd.classList.toggle("open");
          btn.setAttribute("aria-expanded", String(isOpen));
        });
      }

      setupDropdown("sk-learn-dropdown", "sk-learn-btn");
      setupDropdown("sk-dev-dropdown", "sk-dev-btn");
      document.addEventListener("click", () => {
        document.querySelectorAll(".sk-dropdown").forEach((dd) => {
          dd.classList.remove("open");
          const b = dd.querySelector(".sk-dd-trigger");
          if (b) b.setAttribute("aria-expanded", "false");
        });
      });

      let savedLang = "id";
      try { savedLang = localStorage.getItem("sk_lang") || "id"; } catch (e) {}
      applyLang(savedLang);
    })();
  </script>
